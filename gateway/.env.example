# AHI Gateway — environment template.
# Copy to .env (in the same directory) and fill in. The install wizard
# generates this from your answers; edit by hand later if needed.
#
# Keep this file out of git. .env should be chmod 600 (user-only read/write).

# ─── Required: Where AHI lives on disk ────────────────────────────────────
AHI_HOME=
AHI_USER_NAME=

# ─── Telegram identity ────────────────────────────────────────────────────
# Numeric Telegram user id of the primary user. Message @userinfobot on
# Telegram to find yours. Leave blank if not using Telegram.
USER_TELEGRAM_ID=
# Optional: id:label pairs separated by commas. Example:
#   EXTRA_TELEGRAM_IDS=123456789:partner,987654321:assistant
EXTRA_TELEGRAM_IDS=

# ─── Bot tokens ───────────────────────────────────────────────────────────
# Create one Telegram bot per enabled persona via @BotFather.
# Michael — coordinator / strategist.
MICHAEL_BOT_TOKEN=
# Tzali — builder / engineer.
TZALI_BOT_TOKEN=
# Avi — designer / visual conscience.
AVI_BOT_TOKEN=

# ─── LLM keys ─────────────────────────────────────────────────────────────
# Anthropic key — only needed if you want gateway-side direct API access in
# addition to the Claude Max subscription used by Claude Code.
ANTHROPIC_API_KEY=

# ─── Voice (optional) ─────────────────────────────────────────────────────
# Both providers are supported. Configure either or both.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: Google Cloud TTS Chirp 3 HD if you have an enterprise Google
# Cloud project with TTS enabled.
GOOGLE_TTS_API_KEY=

# ─── Gateway runtime (defaults are fine) ──────────────────────────────────
GATEWAY_PORT=18789
GATEWAY_MODE=polling
