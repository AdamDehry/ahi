# AHI settings. AHI Setup writes these for you; edit only if you know you need to.
# Copy to .env next to package.json if you run the server by hand.

# ── Where AHI runs ────────────────────────────────────────────────────────
GATEWAY_PORT=18789
# "polling" (default) or "webhook" for Telegram.
GATEWAY_MODE=polling
# Your app's address. Local by default; AHI Setup sets it when you add a private address (Access anywhere).
AHI_APP_URL=http://localhost:18789
# The hidden OS folder of your AHI home (agents' souls, memory, library, skills, state, logs).
AHI_AI_ROOT=
# Your user id (your name in lowercase). Unset = the first admin in users.json.
AHI_OWNER_ID=
# The claude CLI the agents use. Unset = `claude` on PATH.
AHI_CLAUDE_BIN=

# ── Your agents ───────────────────────────────────────────────────────────
# Michael, Zali, Avi and Miriam are all on. Turn one off with <AGENT>_ENABLED=false.
# ZALI_ENABLED=false
# Optional: a Telegram bot per agent (from @BotFather) to chat from your phone.
MICHAEL_BOT_TOKEN=
ZALI_BOT_TOKEN=
AVI_BOT_TOKEN=
MIRIAM_BOT_TOKEN=
# Your Telegram user id, so messages from you are recognised as yours.
OWNER_TELEGRAM_ID=

# ── Voice (optional) ──────────────────────────────────────────────────────
# Any one of these turns on spoken replies and voice calls for every agent.
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=
GOOGLE_STT_API_KEY=
# Pick a provider per agent: openai | cartesia | elevenlabs | gemini | chirp
# MICHAEL_TTS_PROVIDER=openai

# ── Calendar context ──────────────────────────────────────────────────────
# Adds the Jewish calendar (Hebrew date, Shabbat, holidays) to the agents' sense of time for everyone.
# Each user can also choose it on their own ("jewishCalendar": true in users.json).
AHI_JEWISH_CALENDAR=false

# ── Notifications on your devices (optional) ─────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Extras (optional) ─────────────────────────────────────────────────────
# Phone line for calling Michael: Twilio credentials live in their own private env file (TWILIO_ENV_FILE).
PHONE_ENABLED=
# Smart glasses endpoint: a long random value the glasses app carries.
GLASSES_TOKEN=
