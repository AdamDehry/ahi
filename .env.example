# AHI Suite — root environment template.
# Copy to .env and fill in. The install wizard does this for you, but you can
# edit by hand later. Keep this file out of git (.gitignore covers it).

# Where AHI lives on disk. The install wizard sets this — typically ~/ahi.
AHI_HOME=

# Friendly name your AHI agents use when addressing you ("Sarah", "Daniel", ...).
AHI_USER_NAME=

# Your Telegram numeric user id (find it by messaging @userinfobot on Telegram).
# Optional — only needed if you want agents accessible via Telegram.
USER_TELEGRAM_ID=

# Optional extras: comma-separated id:label pairs (e.g. for a partner sharing
# the same machine). Format: 123456789:partner,987654321:assistant
EXTRA_TELEGRAM_IDS=

# Brain auto-build defaults.
AHI_BRAIN_AUTO_BUILD=true
AHI_RETRIEVAL_HOOK=true
